&mt {
    // flavor = "tap-preferred";
    tapping-term-ms = <200>;
    // quick-tap-ms = <150>;
    // require-prior-idle-ms = <100>;
};

&lt {
    // flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    // require-prior-idle-ms = <100>;
};

&caps_word {
    continue-list = <UNDER N1 N2 N3 N4 N5 N6 N7 N8 N9 N0 BSPC DEL>;
};